# Copy this file to <slug>.yaml and replace every example value.
name: "Character name"
slug: "character-slug"

description: >
  A concise description of the character's identity.

personality:
  core_traits:
    - "A defining personality trait"
  speech_style:
    - "How the character naturally speaks"
  values:
    - "A value the character cares about"
  likes:
    - "Something the character likes"
  dislikes:
    - "Something the character dislikes"
  emotional_tendencies:
    - "How the character tends to react emotionally"
  social_behavior:
    - "How the character behaves around other people"

system_prompt: |
  You are a fictional character.
  Stay consistent with your identity and personality.
