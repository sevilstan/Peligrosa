APP_NAME=Peligrosa
APP_ENV=development
DEBUG=False

TELEGRAM_BOT_TOKEN=

DATABASE_URL=

# docker compose only: the database password (compose builds DATABASE_URL itself)
POSTGRES_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Which provider answers chats: groq | roleplay
AI_PROVIDER=groq
# Roleplay API (OpenAI-compatible). Put the real key ONLY in your private .env.
ROLEPLAY_API_KEY=
ROLEPLAY_BASE_URL=https://api.roleplayapi.com/v1
ROLEPLAY_MODEL=uncensored
# Operator alert when the remaining balance (USD) drops below this
ROLEPLAY_LOW_BALANCE_USD=3.0
# Trial key limits: 2 concurrent / 60 per minute -> set the two AI_MAX_* values
# below to 2 and 60. After the first top-up (8 / 300) you may raise them.

# AI provider calls: give up after this many seconds, retry this many times
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Stay inside the provider's limits (Groq free tier allows 30 requests/minute).
# Extra requests wait in line; after the wait limit the user is asked to retry.
# Counted per process: run one bot per API key.
AI_MAX_REQUESTS_PER_MINUTE=25
AI_MAX_CONCURRENT_REQUESTS=4
AI_MAX_QUEUE_WAIT_SECONDS=60

# Database connections (a reply holds its connection while the AI answers)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Database tests only. Must be a DISPOSABLE database whose name ends with
# "_test": the tests create and drop every table in it.
# TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/peligrosa_test

# Characters writing first. Off by default; users must also opt in with /proactive.
# Telegram does not tell us a user's time zone, so quiet hours use one UTC offset.
INITIATIVE_ENABLED=False
INITIATIVE_CHECK_SECONDS=900
INITIATIVE_MIN_IDLE_HOURS=6
INITIATIVE_MAX_IDLE_DAYS=7
INITIATIVE_MIN_GAP_HOURS=24
INITIATIVE_QUIET_START_HOUR=22
INITIATIVE_QUIET_END_HOUR=9
INITIATIVE_UTC_OFFSET_HOURS=3
INITIATIVE_MAX_PER_CHECK=5

# Log every SQL statement (includes users' message text, so keep it off
# unless you are debugging the database). Independent of DEBUG.
SQL_ECHO=False

# Credits. CREDITS_ENABLED=false means no limits at all (development).
# Set it to true in production. A new user gets TRIAL_CREDITS once; a message
# costs MESSAGE_COST, a group message GROUP_MESSAGE_COST, creating a group
# GROUP_CREATE_COST (free for subscribers, who have a daily message cap).
# ADMIN_TELEGRAM_IDS: comma separated Telegram ids allowed to use
# /grant <telegram_id> <credits>.
CREDITS_ENABLED=false
TRIAL_CREDITS=10
MESSAGE_COST=1
GROUP_MESSAGE_COST=2
GROUP_CREATE_COST=50
IMAGE_COST=5

# Pictures in chats (Xavira, api.xavira.ai). Off until you switch it on.
# Put the real key ONLY in your private .env, never in chat or git.
IMAGES_ENABLED=false
XAVIRA_API_KEY=
XAVIRA_BASE_URL=https://api.xavira.ai
# sd_portrait renders faster; both cost the same Xavira credit.
XAVIRA_RESOLUTION=hd_portrait
XAVIRA_MAX_WAIT_SECONDS=60
# Operator alert when Xavira credits fall below this number.
XAVIRA_LOW_BALANCE=5
IMAGE_STORAGE_DIR=data/images
# Make this many different pictures of a scene before reusing one (0 = never
# reuse, 1 = reuse at once = cheapest). Nobody gets the same picture twice.
IMAGE_CACHE_MIN_VARIANTS=2
IMAGE_OFFER_COOLDOWN_SECONDS=60
IMAGE_OFFER_TTL_SECONDS=900
ADMIN_TELEGRAM_IDS=

# Selling with Telegram Stars (needs CREDITS_ENABLED=true). Prices are in Stars.
# CREDIT_PACKS: "credits:stars" pairs, comma separated; empty = no packs.
CREDIT_PACKS=100:50,300:125,1000:350
# Subscription: nothing is unlimited, messages are included only up to the
# daily cap. SUB_PRICE_STARS=0 turns the subscription off.
SUB_PRICE_STARS=400
SUB_DAYS=30
SUB_DAILY_MESSAGE_CAP=100
SUB_GROUP_CREATE_FREE=true
SUB_BONUS_CREDITS=0
# Natural pacing: a reply is shown as up to PACING_MAX_BUBBLES short bubbles
# with "typing..." pauses (at most PACING_MAX_TOTAL_SECONDS in all). No extra
# AI calls. PACING_ENABLED=false sends one message at once.
PACING_ENABLED=true
PACING_MAX_BUBBLES=3
PACING_MAX_TOTAL_SECONDS=5.0

# Shown by /support and /paysupport (e.g. @yourhandle or an e-mail address).
SUPPORT_CONTACT=

# Health endpoint for uptime checks (GET /health, /stats). 0 = off.
HEALTH_PORT=0
HEALTH_HOST=127.0.0.1

# Error alerts: every ERROR from our code is sent to ADMIN_TELEGRAM_IDS (each
# operator must press /start in the bot once). The same problem is sent once
# per ALERT_DEDUP_SECONDS; at most ALERT_MAX_PER_HOUR messages in total.
ALERT_DEDUP_SECONDS=600
ALERT_MAX_PER_HOUR=20

# Training exports (python -m scripts.export_training_data). Required for the
# export: a private salt of 16+ characters. Never change it, never commit it.
TRAINING_EXPORT_SALT=
