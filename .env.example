APP_NAME=Peligrosa
APP_ENV=development
DEBUG=False

TELEGRAM_BOT_TOKEN=

DATABASE_URL=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# AI provider calls: give up after this many seconds, retry this many times
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2

# Database tests only. Must be a DISPOSABLE database whose name ends with
# "_test": the tests create and drop every table in it.
# TEST_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/peligrosa_test

# Characters writing first. Off by default; users must also opt in with /proactive.
# Telegram does not tell us a user's time zone, so quiet hours use one UTC offset.
INITIATIVE_ENABLED=False
INITIATIVE_CHECK_SECONDS=900
INITIATIVE_MIN_IDLE_HOURS=6
INITIATIVE_MAX_IDLE_DAYS=7
INITIATIVE_MIN_GAP_HOURS=24
INITIATIVE_QUIET_START_HOUR=22
INITIATIVE_QUIET_END_HOUR=9
INITIATIVE_UTC_OFFSET_HOURS=3
INITIATIVE_MAX_PER_CHECK=5

# Log every SQL statement (includes users' message text, so keep it off
# unless you are debugging the database). Independent of DEBUG.
SQL_ECHO=False
